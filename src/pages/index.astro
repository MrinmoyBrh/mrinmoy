---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CircuitSimulator from '../components/CircuitSimulator.astro';
import Principles from '../components/Principles.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import Timeline from '../components/Timeline.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import AtmosphericClouds from '../components/AtmosphericClouds.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter((p) => p.featured);
const additionalProjects = projects.filter((p) => !p.featured);
---

<Layout
  title="Mrinmoy Borah | Backend Software Engineer — Distributed Systems & Resilient Architectures"
  description="Personal portfolio of Mrinmoy Borah, Backend Software Engineer and B.Tech CSE student at Dhemaji Engineering College (2027). Specializing in BullMQ queues, Redis state machines, deterministic caching, and fault-tolerant gateways."
>
  <Header />

  <main id="main-content" class="relative">
    
    <!-- Hero Section (Preserved Untouched) -->
    <Hero />

    <!-- Continuous Atmospheric Cloud Container for All Sections Below Hero -->
    <div class="relative overflow-hidden">
      <!-- Atmospheric Dynamic Cloud Layer (Jet Black #080808, Smoke Grey #929292, Cherry Red #C72C41) -->
      <AtmosphericClouds />

      <!-- Systems / Projects Section -->
      <section id="systems" class="py-24 border-b border-white/5 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
          <div class="max-w-3xl">
            <div class="flex items-center space-x-2 technical-mono text-xs text-coral mb-3">
              <span class="w-1.5 h-1.5 bg-coral inline-block"></span>
              <span class="tracking-widest uppercase">PROJECT SHOWCASE // CODE & RESEARCH</span>
            </div>
            <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-pearl mb-4">
              Systems I've built.
            </h2>
            <p class="text-smoke-light text-base leading-relaxed">
              A breakdown of projects I have engineered across distributed task queues, state utility administration, and academic computer vision research.
            </p>
          </div>

          <div class="technical-mono text-xs text-smoke-dark shrink-0">
            [SYS_REGISTRY // 05 ACTIVE]
          </div>
        </div>

        <!-- Featured Projects Grid (Custom HUD Panels) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-7 mb-14">
          {featuredProjects.map((project, idx) => (
            <ProjectCard project={project} index={idx} />
          ))}
        </div>

        <!-- Additional Engineering Repositories -->
        <div class="pt-10 border-t border-white/5">
          <div class="flex items-center justify-between mb-6">
            <h3 class="technical-mono text-xs uppercase tracking-wider text-smoke-light font-bold">
              ADDITIONAL REPOSITORIES // SANDBOXING & 3NF STORAGE
            </h3>
            <span class="text-[10px] technical-mono text-smoke-dark">LOCAL REPOS</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-7">
            {additionalProjects.map((project, idx) => (
              <ProjectCard project={project} index={idx + featuredProjects.length} />
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- Interactive Circuit Breaker & Queue Simulator -->
    <CircuitSimulator />

    <!-- Engineering Principles Manifesto -->
    <Principles />

    <!-- Curated Skills Matrix -->
    <SkillsGrid />

    <!-- Timeline / Education & Experience -->
    <Timeline />

      <!-- Contact & Interactive Terminal -->
      <ContactSection />
    </div>

  </main>

  <Footer />
</Layout>
