---
import InteractiveTerminal from './InteractiveTerminal.astro';
---

<section id="contact" class="py-24 border-b border-white/5 relative overflow-hidden">
  
  <!-- Subtle background ambient orbital glow -->
  <div class="absolute bottom-0 right-1/4 w-[450px] h-[450px] bg-coral/5 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Editorial Dispatch Invitation -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center space-x-2 technical-mono text-xs text-coral mb-3">
            <span class="w-2 h-2 rounded-full bg-coral animate-ping"></span>
            <span>TRANSMISSION DISPATCH</span>
          </div>

          <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-pearl mb-6">
            Let's build reliable systems.
          </h2>

          <p class="text-smoke-light text-base leading-relaxed mb-8">
            Whether you are engineering a high-concurrency microservice cluster, architecting fault-tolerant queues, or seeking a dedicated backend engineer for internships or engineering roles—I'm ready to contribute.
          </p>

          <!-- Direct Coordinates Grid -->
          <div class="space-y-4 mb-8">
            
            <!-- Email Item with Copy Button -->
            <div class="p-4 rounded-xl bg-ink-900 border border-white/10 flex items-center justify-between shadow-surface-elevated">
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-coral/10 border border-coral/20 flex items-center justify-center text-coral">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-[11px] technical-mono text-smoke">DIRECT EMAIL</span>
                  <a
                    href="mailto:mrinmoyborah360@gmail.com"
                    class="block text-xs sm:text-sm font-semibold technical-mono text-pearl hover:text-coral transition-colors"
                  >
                    mrinmoyborah360@gmail.com
                  </a>
                </div>
              </div>

              <button
                id="copy-email-btn"
                type="button"
                aria-label="Copy email address to clipboard"
                class="px-2.5 py-1.5 rounded-md bg-ink-950 hover:bg-white/10 text-smoke-light hover:text-pearl border border-white/10 technical-mono text-[11px] transition-colors flex items-center space-x-1"
              >
                <span id="copy-text">COPY</span>
              </button>
            </div>

            <!-- Social Links Grid -->
            <div class="grid grid-cols-2 gap-3">
              <a
                href="https://github.com/MrinmoyBrh"
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-xl bg-ink-900 border border-white/10 hover:border-white/20 transition-all duration-200 flex items-center space-x-3 group shadow-surface-elevated"
              >
                <div class="w-8 h-8 rounded-lg bg-ink-950 flex items-center justify-center text-smoke-light group-hover:text-pearl">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-[10px] technical-mono text-smoke">SOURCE CODE</span>
                  <span class="block text-xs font-bold technical-mono text-pearl group-hover:text-coral transition-colors">GitHub ↗</span>
                </div>
              </a>

              <a
                href="https://www.linkedin.com/in/mrinmoy-borah-7771843b9/"
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-xl bg-ink-900 border border-white/10 hover:border-white/20 transition-all duration-200 flex items-center space-x-3 group shadow-surface-elevated"
              >
                <div class="w-8 h-8 rounded-lg bg-ink-950 flex items-center justify-center text-smoke-light group-hover:text-pearl">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-[10px] technical-mono text-smoke">NETWORK</span>
                  <span class="block text-xs font-bold technical-mono text-pearl group-hover:text-coral transition-colors">LinkedIn ↗</span>
                </div>
              </a>
            </div>

          </div>
        </div>

        <div class="p-4 rounded-xl bg-ink-950 border border-white/5">
          <div class="flex items-center space-x-2 text-[11px] technical-mono text-smoke mb-1">
            <span class="w-2 h-2 rounded-full bg-orbital"></span>
            <span>AVAILABILITY STATUS</span>
          </div>
          <p class="text-xs text-pearl leading-relaxed">
            Open for Backend Engineering Internships, Junior Backend Roles, & Collaborative Systems Engineering.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Terminal -->
      <div class="lg:col-span-7">
        <div class="mb-3 flex items-center justify-between text-xs technical-mono text-smoke">
          <span>// INTERACTIVE TELEMETRY TERMINAL</span>
          <span>TRY: 'status', 'whoami', 'stack'</span>
        </div>
        <InteractiveTerminal />
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const email = 'mrinmoyborah360@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) copyText.textContent = 'COPIED!';
      setTimeout(() => {
        if (copyText) copyText.textContent = 'COPY';
      }, 2000);
    } catch (err) {
      // Fallback
      if (copyText) copyText.textContent = 'DONE';
    }
  });
</script>
