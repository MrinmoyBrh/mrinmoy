---
import { skillGroups } from '../data/skills';
---

<section id="skills" class="py-24 sm:py-28 border-b border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="flex items-center space-x-2 technical-mono text-xs text-cherry mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cherry"></span>
        <span>EXPERTISE & TOOLS</span>
      </div>
      <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-softwhite mb-6">
        How I Build.
      </h2>
      <p class="text-smokegrey text-base sm:text-lg leading-relaxed">
        I enjoy working on the parts of an application that people don't always see. From handling requests to managing data and connecting different services, I'm interested in understanding how everything works together. I'm constantly learning new technologies and finding better ways to build applications that are reliable, efficient, and easy to maintain.
      </p>
    </div>

    <!-- Clean Modern Editorial Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
      {skillGroups.map((group) => (
        <div class="group p-6 sm:p-8 rounded-2xl bg-charcoal/50 border border-white/[0.04] hover:border-white/[0.08] transition-all duration-300">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/[0.04]">
            <h3 class="font-display font-semibold text-lg sm:text-xl text-softwhite tracking-tight">
              {group.category}
            </h3>
            <span class="w-2 h-2 rounded-full bg-white/10 group-hover:bg-cherry/60 transition-colors"></span>
          </div>

          <!-- Skills List -->
          <div class="flex flex-wrap gap-2 sm:gap-2.5">
            {group.skills.map((skill) => (
              <span class="px-3 py-1.5 rounded-lg text-xs sm:text-sm technical-mono text-smokegrey hover:text-softwhite bg-jet/60 border border-white/[0.04] hover:border-white/10 transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
