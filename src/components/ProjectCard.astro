---
import type { ProjectCaseStudy } from '../data/projects';

interface Props {
  project: ProjectCaseStudy;
  index: number;
}

const { project, index } = Astro.props;
const displayIndex = String(index + 1).padStart(2, '0');
const variant = index % 3; // 0: Chamfered Top-Right, 1: Stepped Crosshair, 2: Chamfered Bottom-Left

const tagLabel = project.organization
  ? (project.organization.includes('Assam') ? 'APGCL_INTERN' : 'NIT_SILCHAR')
  : (project.githubUrl ? 'OPEN_SRC' : 'SYSTEM_NODE');
---

<article
  class:list={[
    "group relative bg-[#0D1524] border border-white/10 hover:border-coral/50 transition-all duration-300 p-6 sm:p-7 flex flex-col justify-between hud-scan-line shadow-surface-elevated",
    variant === 0 && "hud-cut-tr",
    variant === 1 && "hud-cut-diagonal",
    variant === 2 && "hud-cut-bl"
  ]}
>
  {/* Variant 0 Accent: Top-Right Notch */}
  {variant === 0 && (
    <>
      <div class="absolute top-0 right-0 w-5 h-5 border-t-2 border-r-2 border-coral pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -top-px left-8 w-12 h-px bg-coral pointer-events-none" aria-hidden="true"></div>
    </>
  )}

  {/* Variant 1 Accent: Corner Crosshairs */}
  {variant === 1 && (
    <>
      <span class="absolute top-1 left-1.5 text-[9px] technical-mono text-smoke/40 select-none pointer-events-none" aria-hidden="true">+</span>
      <span class="absolute top-1 right-1.5 text-[9px] technical-mono text-smoke/40 select-none pointer-events-none" aria-hidden="true">+</span>
      <span class="absolute bottom-1 left-1.5 text-[9px] technical-mono text-smoke/40 select-none pointer-events-none" aria-hidden="true">+</span>
      <span class="absolute bottom-1 right-1.5 text-[9px] technical-mono text-coral select-none pointer-events-none" aria-hidden="true">+</span>
      <div class="absolute -top-px right-16 w-8 h-px bg-white/20 pointer-events-none" aria-hidden="true"></div>
    </>
  )}

  {/* Variant 2 Accent: Bottom-Left Notch */}
  {variant === 2 && (
    <>
      <div class="absolute bottom-0 left-0 w-5 h-5 border-b-2 border-l-2 border-coral pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -top-px right-10 w-12 h-px bg-smoke/40 pointer-events-none" aria-hidden="true"></div>
      <span class="absolute top-1 left-1.5 text-[9px] technical-mono text-smoke/40 select-none pointer-events-none" aria-hidden="true">+</span>
    </>
  )}

  <div>
    {/* Technical HUD Header Bar */}
    <div class="flex items-center justify-between pb-3 mb-5 border-b border-white/5 technical-mono text-[11px]">
      <div class="flex items-center space-x-2">
        <span class:list={[
          "w-1.5 h-1.5 inline-block",
          variant === 0 ? "bg-coral" : variant === 1 ? "bg-orbital" : "bg-smoke"
        ]}></span>
        <span class="text-coral font-bold tracking-wider">SYS_{displayIndex}</span>
        <span class="text-white/20">//</span>
        <span class="text-smoke uppercase">{project.category}</span>
      </div>
      <div class="flex items-center space-x-2 text-smoke-dark">
        <span class="border border-white/10 px-1.5 py-0.5 bg-black/40 text-[10px] text-smoke-light">
          {tagLabel}
        </span>
      </div>
    </div>

    {/* Title & Headline */}
    <h3 class="font-display text-xl sm:text-2xl font-bold text-pearl group-hover:text-coral-light transition-colors mb-3 leading-snug">
      <a href={`/projects/${project.slug}`} class="focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-coral">
        {project.title}
      </a>
    </h3>

    {/* Human-written Summary */}
    <p class="text-xs sm:text-sm text-smoke-light leading-relaxed mb-6 font-normal">
      {project.summary}
    </p>

    {/* Technical Architecture Highlights */}
    <div class="mb-6 p-3.5 bg-[#090E1A] border-l-2 border-y border-r border-white/5 space-y-2"
         class:list={[
           variant === 0 ? "border-l-coral" : variant === 1 ? "border-l-orbital" : "border-l-smoke"
         ]}>
      <div class="text-[10px] technical-mono uppercase tracking-wider text-smoke font-semibold mb-1">
        Key implementation details:
      </div>
      {project.verifiedClaims.slice(0, 3).map((claim) => (
        <div class="flex items-start space-x-2 text-xs text-smoke-light">
          <span class="text-coral technical-mono text-[11px] shrink-0 font-bold">&gt;</span>
          <span class="leading-tight text-[11px] technical-mono">{claim}</span>
        </div>
      ))}
    </div>

    {/* Bracketed Tech Tags */}
    <div class="flex flex-wrap gap-1.5 mb-6 technical-mono text-[11px]">
      {project.badges.map((badge) => (
        <span class="px-2 py-0.5 bg-white/5 hover:bg-white/10 text-smoke-light hover:text-pearl transition-colors border border-white/5">
          [{badge}]
        </span>
      ))}
    </div>
  </div>

  {/* HUD Action Footer */}
  <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs technical-mono">
    <a
      href={`/projects/${project.slug}`}
      class="inline-flex items-center space-x-1.5 text-pearl hover:text-coral font-medium transition-colors"
    >
      <span>Case study</span>
      <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
    </a>

    {project.githubUrl && (
      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-smoke hover:text-pearl transition-colors flex items-center space-x-1 text-[11px]"
      >
        <span>source</span>
        <span>&nearr;</span>
      </a>
    )}
  </div>

</article>
