---
---

<div id="terminal" class="rounded-2xl bg-jet border border-white/[0.06] p-4 sm:p-6 shadow-surface-elevated font-mono">
  
  <!-- Terminal Titlebar -->
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/[0.06] text-xs">
    <div class="flex items-center space-x-2">
      <span class="w-2.5 h-2.5 rounded-full bg-cherry inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/20 inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/10 inline-block"></span>
      <span class="text-smokegrey text-[11px] ml-2">mrinmoy@terminal:~</span>
    </div>
    <div class="flex items-center space-x-3 text-[10px] text-smokegrey">
      <span>SHELL: zsh</span>
      <span>•</span>
      <span>ENV: PRODUCTION</span>
    </div>
  </div>

  <!-- Terminal Output Buffer -->
  <div id="term-output" class="text-xs sm:text-sm text-smokegrey space-y-2 min-h-[200px] max-h-[340px] overflow-y-auto pr-2">
    <div>
      <span class="text-softwhite font-semibold">Mrinmoy Borah</span> <span class="text-cherry">[Backend Software Engineer / B.Tech CSE 2027]</span>
    </div>
    <div class="text-smokegrey">
      Type <span class="text-softwhite font-bold">help</span> to view available system commands, or execute <span class="text-cherry font-bold">contact</span> to dispatch an email.
    </div>
    <div class="text-smokegrey text-xs">
      Session connected to live node at 26.14°N, 91.73°E.
    </div>
  </div>

  <!-- Terminal Input Line -->
  <form id="term-form" class="mt-4 pt-3 border-t border-white/[0.06] flex items-center space-x-2">
    <label for="term-input" class="text-cherry font-bold text-sm shrink-0">
      mrinmoy&gt;
    </label>
    <input
      id="term-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="Type 'help', 'status', 'projects', or 'contact'..."
      class="w-full bg-transparent text-softwhite text-xs sm:text-sm font-mono border-none outline-none focus:ring-0 p-0 placeholder:text-white/20"
    />
  </form>

</div>

<script>
  const termForm = document.getElementById('term-form') as HTMLFormElement;
  const termInput = document.getElementById('term-input') as HTMLInputElement;
  const termOutput = document.getElementById('term-output') as HTMLDivElement;

  const COMMANDS: Record<string, string | (() => string)> = {
    help: `Available commands:
  - whoami     : Print engineer biography & role
  - status     : Check system runtime, Redis health & BullMQ telemetry
  - projects   : List verified architecture case studies
  - stack      : Display verified backend technologies
  - principles : Print the "Building for the Unexpected" perspective
  - contact    : View direct contact coordinates & mailto link
  - clear      : Clear terminal screen`,
    whoami: `Mrinmoy Borah
Role: Backend Software Engineer
Education: B.Tech Computer Science & Engineering, Dhemaji Engineering College (2023 - 2027)
Focus: Backend Development, Databases, Resilient Queues, Container Sandboxing.`,
    status: `[SYS STATUS: NOMINAL]
Node: worker-01.production
Redis Cluster: Connected (State: OK, CB: CLOSED)
BullMQ Queues: ai-tasks [Concurrency: 5, Active: 0, Failed: 0]
Cache Hit Latency: <5ms (Deterministic SHA-256)
Uptime: 99.98%`,
    projects: `Verified Case Studies:
  1. ai-resilient-gateway: Fastify, BullMQ, Redis Circuit Breakers, SHA-256 Cache
  2. apgcl-app: Laravel 13, PHP 8.4, WebAuthn Passkeys, 2FA, Email Notifications
  3. crop-disease-detection: Academic Research with NIT Silchar, OpenCV, Deep Learning
  4. microbounty: Ephemeral Docker sandboxing, network-disabled, memory-capped
  5. securevault: Self-hosted Python storage engine with 3NF MySQL deduplication`,
    stack: `Backend Development: Node.js, TypeScript, Express.js, Fastify, Python, Laravel, PHP, REST APIs
Databases: PostgreSQL, MySQL, MongoDB, Redis
Cloud & Infrastructure: Docker, Linux, Nginx, Git & GitHub
Developer Tools: Postman, VS Code, npm, Vite`,
    principles: `Building for the Unexpected:
  01. Expect Things to Go Wrong — Think about failure scenarios early to save trouble later.
  02. Keep Things Simple — Choose solutions that are practical, clear, and easy to maintain.
  03. Learn from What Breaks — Approach debugging as a learning experience.`,
    contact: `Contact Coordinates:
  - Email: mrinmoyborah360@gmail.com
  - GitHub: https://github.com/MrinmoyBrh
  - LinkedIn: https://www.linkedin.com/in/mrinmoy-borah-7771843b9/
  - Location: Assam, India`
  };

  function appendTerminal(cmd: string, response: string) {
    if (!termOutput) return;

    const cmdLine = document.createElement('div');
    cmdLine.className = 'text-cherry mt-2';
    cmdLine.textContent = `mrinmoy> ${cmd}`;
    termOutput.appendChild(cmdLine);

    const respLine = document.createElement('div');
    respLine.className = 'whitespace-pre-wrap text-smokegrey leading-relaxed';
    respLine.textContent = response;
    termOutput.appendChild(respLine);

    termOutput.scrollTop = termOutput.scrollHeight;
  }

  termForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const cmd = termInput.value.trim().toLowerCase();
    termInput.value = '';

    if (!cmd) return;

    if (cmd === 'clear') {
      termOutput.innerHTML = '';
      return;
    }

    if (COMMANDS[cmd]) {
      const resp = typeof COMMANDS[cmd] === 'function' ? (COMMANDS[cmd] as any)() : COMMANDS[cmd];
      appendTerminal(cmd, resp);
    } else {
      appendTerminal(cmd, `zsh: command not found: ${cmd}. Type 'help' for available commands.`);
    }
  });
</script>
