---
import { getAppearanceSettings } from '../lib/content';

let cloudsConfig = {
  enabled: true,
  opacity: 0.14,
  blurPx: 120,
  speedMultiplier: 1.0,
  cloud1Color: '#C72C41',
  cloud2Color: '#929292',
  cloud3Color: '#A82436',
};

try {
  const app = await getAppearanceSettings(true);
  if (app?.cloudAnimation) {
    cloudsConfig = { ...cloudsConfig, ...app.cloudAnimation };
  }
} catch (e) {
  // Fallback
}
---

<!-- ==========================================================================
     Atmospheric Clouds Background
     Organic, randomized drifting cloud gradients in Jet Black (#080808),
     Smoke Grey (#929292), and Cherry Red (#C72C41).
     Applied continuously behind all sections below the Hero.
     ========================================================================== -->

{cloudsConfig.enabled && (
<div
  id="atmospheric-clouds-layer"
  class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none -z-10 bg-[#080808]"
  aria-hidden="true"
>
  <!-- Background vignette anchoring jet-black tone -->
  <div class="absolute inset-0 bg-[#080808]/70 pointer-events-none z-10"></div>

  <!-- Dynamic Cloud Blobs Container -->
  <div id="clouds-stage" class="absolute inset-0 w-full h-full overflow-hidden">
    
    <!-- CLOUD 1: Deep Cherry Red Accent (Upper Systems Zone) -->
    <div
      class="atmospheric-cloud cloud-cherry"
      data-cloud-id="0"
      style="
        top: 6%;
        left: 8%;
        width: 780px;
        height: 720px;
        background: radial-gradient(circle at 45% 45%, rgba(199, 44, 65, 0.16) 0%, rgba(160, 30, 48, 0.08) 40%, rgba(100, 15, 25, 0.02) 65%, transparent 75%);
        filter: blur(95px);
        border-radius: 46% 54% 62% 38% / 42% 58% 42% 58%;
      "
    ></div>

    <!-- CLOUD 2: Smoke Grey Mist (Mid-Upper Systems / Architecture Zone) -->
    <div
      class="atmospheric-cloud cloud-smoke"
      data-cloud-id="1"
      style="
        top: 18%;
        right: 6%;
        width: 860px;
        height: 800px;
        background: radial-gradient(circle at 50% 50%, rgba(146, 146, 146, 0.13) 0%, rgba(110, 110, 110, 0.06) 45%, rgba(60, 60, 60, 0.015) 70%, transparent 75%);
        filter: blur(105px);
        border-radius: 58% 42% 38% 62% / 52% 48% 52% 48%;
      "
    ></div>

    <!-- CLOUD 3: Soft Cherry Red Glow (Architecture & Principles Zone) -->
    <div
      class="atmospheric-cloud cloud-cherry"
      data-cloud-id="2"
      style="
        top: 36%;
        left: 14%;
        width: 820px;
        height: 760px;
        background: radial-gradient(circle at 50% 50%, rgba(199, 44, 65, 0.14) 0%, rgba(140, 25, 40, 0.06) 42%, transparent 70%);
        filter: blur(100px);
        border-radius: 40% 60% 55% 45% / 48% 42% 58% 52%;
      "
    ></div>

    <!-- CLOUD 4: Smoke Grey Atmospheric Fog (Principles & Skills Zone) -->
    <div
      class="atmospheric-cloud cloud-smoke"
      data-cloud-id="3"
      style="
        top: 50%;
        right: 12%;
        width: 900px;
        height: 840px;
        background: radial-gradient(circle at 55% 45%, rgba(146, 146, 146, 0.12) 0%, rgba(95, 95, 95, 0.05) 45%, transparent 70%);
        filter: blur(110px);
        border-radius: 52% 48% 44% 56% / 46% 54% 46% 54%;
      "
    ></div>

    <!-- CLOUD 5: Deep Cherry Red Pulse (Timeline / Experience Zone) -->
    <div
      class="atmospheric-cloud cloud-cherry"
      data-cloud-id="4"
      style="
        top: 68%;
        left: 6%;
        width: 800px;
        height: 750px;
        background: radial-gradient(circle at 45% 55%, rgba(199, 44, 65, 0.15) 0%, rgba(150, 28, 42, 0.06) 40%, transparent 70%);
        filter: blur(105px);
        border-radius: 44% 56% 60% 40% / 50% 45% 55% 50%;
      "
    ></div>

    <!-- CLOUD 6: Smoke Grey Drift (Terminal & Contact Zone) -->
    <div
      class="atmospheric-cloud cloud-smoke"
      data-cloud-id="5"
      style="
        top: 84%;
        right: 8%;
        width: 920px;
        height: 850px;
        background: radial-gradient(circle at 50% 50%, rgba(146, 146, 146, 0.14) 0%, rgba(100, 100, 100, 0.06) 45%, transparent 70%);
        filter: blur(115px);
        border-radius: 60% 40% 48% 52% / 54% 46% 54% 46%;
      "
    ></div>

    <!-- CLOUD 7: Subtle Cherry Red Horizon Glow (Lower Contact Edge) -->
    <div
      class="atmospheric-cloud cloud-cherry"
      data-cloud-id="6"
      style="
        top: 93%;
        left: 28%;
        width: 750px;
        height: 680px;
        background: radial-gradient(circle at 50% 50%, rgba(199, 44, 65, 0.12) 0%, rgba(130, 20, 35, 0.04) 45%, transparent 70%);
        filter: blur(95px);
        border-radius: 50% 50% 58% 42% / 46% 54% 46% 54%;
      "
    ></div>

  </div>
</div>

<style>
  .atmospheric-cloud {
    position: absolute;
    will-change: transform, opacity;
    pointer-events: none;
    mix-blend-mode: screen;
  }
</style>

<script>
  // ========================================================================
  // Randomized Motion Algorithm for Atmospheric Clouds
  // Deterministically seeded per page visit using a fast PRNG (Mulberry32).
  // Generates unique starting offsets, drift frequencies, amplitudes, and
  // breathing scales that smoothly interpolate without sudden transitions.
  // ========================================================================

  (function initAtmosphericClouds() {
    // Check user preference for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const clouds = document.querySelectorAll<HTMLElement>('.atmospheric-cloud');
    if (!clouds.length) return;

    // Fast Pseudo-Random Number Generator (Mulberry32)
    // Generates a fresh seed each time the page is loaded/visited
    const visitSeed = Math.floor(Math.random() * 0xFFFFFFFF);
    function mulberry32(seed: number) {
      return function () {
        let t = (seed += 0x6D2B79F5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rng = mulberry32(visitSeed);

    // Cloud parameter profiles initialized per page visit
    interface CloudConfig {
      element: HTMLElement;
      baseX: number;
      baseY: number;
      driftRadiusX: number;
      driftRadiusY: number;
      speedX: number;
      speedY: number;
      speedScale: number;
      speedOpacity: number;
      phaseX: number;
      phaseY: number;
      phaseScale: number;
      phaseOpacity: number;
      baseScale: number;
      scaleRange: number;
      baseOpacity: number;
      opacityRange: number;
    }

    const configs: CloudConfig[] = [];

    clouds.forEach((cloud) => {
      // Randomized starting parameters per visit
      const initialOffsetX = (rng() - 0.5) * 120; // -60px to +60px
      const initialOffsetY = (rng() - 0.5) * 90;  // -45px to +45px
      
      const config: CloudConfig = {
        element: cloud,
        baseX: initialOffsetX,
        baseY: initialOffsetY,
        // Safe boundaries: gentle wide drift
        driftRadiusX: 70 + rng() * 90,   // 70px to 160px
        driftRadiusY: 50 + rng() * 80,   // 50px to 130px
        // Very slow, continuous organic frequency (0.00015 to 0.00045 rad/ms)
        speedX: 0.00018 + rng() * 0.00022,
        speedY: 0.00015 + rng() * 0.00020,
        speedScale: 0.00022 + rng() * 0.00025,
        speedOpacity: 0.00018 + rng() * 0.00020,
        // Staggered phases
        phaseX: rng() * Math.PI * 2,
        phaseY: rng() * Math.PI * 2,
        phaseScale: rng() * Math.PI * 2,
        phaseOpacity: rng() * Math.PI * 2,
        // Breathing scale
        baseScale: 0.95 + rng() * 0.1,
        scaleRange: 0.12 + rng() * 0.10, // Expands/contracts gently by 12%-22%
        // Subtle opacity
        baseOpacity: 0.78 + rng() * 0.15,
        opacityRange: 0.14 + rng() * 0.10,
      };

      configs.push(config);
    });

    let startTime = performance.now();
    let animationFrameId: number;

    function animateClouds(currentTime: number) {
      const elapsed = currentTime - startTime;

      for (let i = 0; i < configs.length; i++) {
        const c = configs[i];

        // Smooth sinusoidal organic drift using trigonometric synthesis
        // (Combines primary drift with harmonic wave for non-linear, cloud-like motion)
        const dx = Math.sin(elapsed * c.speedX + c.phaseX) * c.driftRadiusX +
                   Math.sin(elapsed * (c.speedX * 0.5) + c.phaseY) * (c.driftRadiusX * 0.35);

        const dy = Math.cos(elapsed * c.speedY + c.phaseY) * c.driftRadiusY +
                   Math.cos(elapsed * (c.speedY * 0.6) + c.phaseX) * (c.driftRadiusY * 0.3);

        const scale = c.baseScale + Math.sin(elapsed * c.speedScale + c.phaseScale) * c.scaleRange;
        const opacity = Math.min(1, Math.max(0.4, c.baseOpacity + Math.sin(elapsed * c.speedOpacity + c.phaseOpacity) * c.opacityRange));

        // High-performance 3D transform with GPU acceleration
        c.element.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${scale.toFixed(3)})`;
        c.element.style.opacity = opacity.toFixed(3);
      }

      animationFrameId = requestAnimationFrame(animateClouds);
    }

    // Start continuous, non-blocking RAF loop
    animationFrameId = requestAnimationFrame(animateClouds);

    // Cleanup listener on page unload / navigation
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(animationFrameId);
    }, { once: true });
  })();
</script>
)}
