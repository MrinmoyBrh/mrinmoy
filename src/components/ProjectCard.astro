---
import type { ProjectCaseStudy } from '../data/projects';

interface Props {
  project: ProjectCaseStudy;
  index: number;
}

const { project, index } = Astro.props;
const displayIndex = String(index + 1).padStart(2, '0');
---

<article class="group relative rounded-2xl bg-ink-900 border border-white/10 hover:border-white/20 transition-all duration-300 p-6 sm:p-8 flex flex-col justify-between shadow-surface-elevated">
  
  <div>
    <!-- Card Header Dossier -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-white/5">
      <div class="flex items-center space-x-3">
        <span class="technical-mono text-xs font-bold text-coral">
          SYS // {displayIndex}
        </span>
        <span class="text-white/20" aria-hidden="true">•</span>
        <span class="text-xs technical-mono text-smoke font-medium">
          {project.category}
        </span>
      </div>

      <div class="flex items-center space-x-2">
        {project.organization && (
          <span class="text-[11px] technical-mono text-smoke-light px-2.5 py-1 rounded bg-white/5 border border-white/5">
            {project.organization}
          </span>
        )}
        <span class="text-[11px] technical-mono text-smoke px-2 py-1 rounded bg-ink-950">
          {project.period}
        </span>
      </div>
    </div>

    <!-- Title & Tagline -->
    <h3 class="editorial-title text-2xl sm:text-3xl font-bold text-pearl group-hover:text-coral-light transition-colors mb-3">
      <a href={`/projects/${project.slug}`} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coral rounded">
        {project.title}
      </a>
    </h3>

    <p class="text-sm sm:text-base text-smoke-light font-normal leading-relaxed mb-6">
      {project.summary}
    </p>

    <!-- Verified Technical Highlights -->
    <div class="space-y-2 mb-6 p-4 rounded-xl bg-ink-950/80 border border-white/5">
      <span class="block text-[11px] technical-mono font-bold text-orbital uppercase tracking-wider mb-2">
        VERIFIED IMPLEMENTATION CLAIMS
      </span>
      {project.verifiedClaims.slice(0, 3).map((claim) => (
        <div class="flex items-start space-x-2 text-xs text-smoke-light">
          <svg class="w-4 h-4 text-orbital shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="technical-mono text-[11px] leading-tight">{claim}</span>
        </div>
      ))}
    </div>

    <!-- Stack Badges -->
    <div class="flex flex-wrap gap-1.5 mb-8">
      {project.badges.map((badge) => (
        <span class="px-2.5 py-1 rounded text-[11px] technical-mono bg-white/5 hover:bg-white/10 text-smoke-light border border-white/5 transition-colors">
          {badge}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom CTA Actions -->
  <div class="flex items-center justify-between pt-5 border-t border-white/5">
    <a
      href={`/projects/${project.slug}`}
      class="inline-flex items-center space-x-2 text-xs sm:text-sm font-semibold technical-mono text-pearl hover:text-coral transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coral"
    >
      <span>Read Architecture Case Study</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    {project.githubUrl && (
      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`GitHub Repository for ${project.title}`}
        class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs technical-mono text-smoke hover:text-pearl bg-ink-950 border border-white/5 hover:border-white/15 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>Source</span>
      </a>
    )}
  </div>

</article>
