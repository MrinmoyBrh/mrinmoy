---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404: Node Not Found | Mrinmoy Borah"
  description="The requested routing endpoint does not exist in the system cluster."
>
  <Header />

  <main id="main-content" class="min-h-[75vh] flex items-center justify-center py-20">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-coral/10 border border-coral/30 text-coral technical-mono text-xs mb-6">
        <span>ERROR CODE // HTTP 404</span>
      </div>

      <h1 class="editorial-title text-6xl sm:text-7xl font-black text-pearl mb-4">
        Endpoint Missing.
      </h1>

      <p class="text-smoke-light text-sm sm:text-base leading-relaxed mb-8">
        The requested routing node has been decommissioned, partitioned, or never existed in the cluster topology.
      </p>

      <div class="p-4 rounded-xl bg-ink-900 border border-white/10 technical-mono text-xs text-smoke-light text-left mb-8 space-y-1">
        <div class="text-coral">FATAL: Route lookup failed</div>
        <div>status: 404 Not Found</div>
        <div>upstream: gateway.cluster.local</div>
        <div class="text-orbital">suggested_action: redirect to /</div>
      </div>

      <a
        href="/"
        class="inline-flex items-center space-x-2 px-6 py-3 rounded-lg bg-coral text-ink-950 font-bold technical-mono text-xs hover:bg-coral-hover transition-colors shadow-glow-coral"
      >
        <span>← Return to System Core</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
