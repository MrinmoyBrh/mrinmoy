---
import { principles } from '../data/principles';
---

<section id="principles" class="py-24 sm:py-28 border-b border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="flex items-center space-x-2 technical-mono text-xs text-cherry mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cherry"></span>
        <span>ENGINEERING PERSPECTIVE</span>
      </div>
      <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-softwhite mb-6">
        Building for the Unexpected.
      </h2>
      <p class="text-smokegrey text-base sm:text-lg leading-relaxed">
        One thing I've learned while building projects is that making something work is only the beginning. Things don't always go as planned, and understanding how to handle those situations is an important part of becoming a better developer.
      </p>
    </div>

    <!-- Three Elegant Numbered Sections Separated by Subtle Lines -->
    <div class="border-t border-white/[0.06]">
      {principles.map((principle) => (
        <article class="py-10 sm:py-14 border-b border-white/[0.06] grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start group">
          
          <!-- Number and Title (5 cols) -->
          <div class="md:col-span-5 flex items-baseline space-x-4">
            <span class="technical-mono text-xl sm:text-2xl font-bold text-cherry shrink-0">
              {principle.number}
            </span>
            <h3 class="font-display font-semibold text-xl sm:text-2xl text-softwhite tracking-tight group-hover:text-cherry-light transition-colors">
              {principle.title}
            </h3>
          </div>

          <!-- Narrative Body (7 cols) -->
          <div class="md:col-span-7">
            <p class="text-smokegrey text-base sm:text-lg leading-relaxed">
              {principle.description}
            </p>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
