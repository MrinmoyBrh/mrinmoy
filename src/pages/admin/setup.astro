---
import { getAdminUserCount } from '../../lib/auth';

export const prerender = false;

const adminCount = getAdminUserCount();
if (adminCount > 0) {
  return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initial Setup — Portfolio CMS</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#111111] text-[#F5F5F5] min-h-screen flex items-center justify-center p-4 antialiased font-sans">
    
    <div class="w-full max-w-lg">
      
      <!-- Fintrixity Setup Card -->
      <div class="bg-[#191919] border border-[#343434] rounded-2xl p-7 sm:p-10 shadow-2xl relative overflow-hidden">
        
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#FF5A1F] to-transparent"></div>

        <div class="text-center mb-8">
          <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#FF5A1F]/10 text-[#FF5A1F] border border-[#FF5A1F]/30 mb-3">
            INITIAL CONFIGURATION
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-[#F5F5F5]">Create Administrator Account</h1>
          <p class="text-xs text-[#929292] mt-1.5 max-w-sm mx-auto">
            Set up your primary administrator credentials to manage your personal portfolio.
          </p>
        </div>

        <div id="error-alert" class="hidden mb-6 p-3 rounded-lg bg-[#EF4444]/10 border border-[#EF4444]/30 text-xs text-[#EF4444] font-medium flex items-center space-x-2">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span id="error-message"></span>
        </div>

        <form id="setup-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Full Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              value="Mrinmoy Borah"
              class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3.5 py-2.5 text-sm text-[#F5F5F5] focus:outline-none focus:border-[#FF5A1F] transition-colors"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="username" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                required
                value="mrinmoy"
                class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3.5 py-2.5 text-sm text-[#F5F5F5] focus:outline-none focus:border-[#FF5A1F] transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                value="mrinmoyborah360@gmail.com"
                class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3.5 py-2.5 text-sm text-[#F5F5F5] focus:outline-none focus:border-[#FF5A1F] transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="8"
              placeholder="Minimum 8 characters"
              class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3.5 py-2.5 text-sm text-[#F5F5F5] placeholder-[#555555] focus:outline-none focus:border-[#FF5A1F] transition-colors"
            />
            <span class="text-[10px] text-[#929292] mt-1 block">Hashed securely with salted bcrypt (12 rounds) on disk.</span>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full mt-4 py-2.5 px-4 bg-[#FF5A1F] hover:bg-[#FF7849] text-black font-bold text-sm rounded-lg transition-all duration-200 shadow-md shadow-[#FF5A1F]/20 flex items-center justify-center space-x-2"
          >
            <span>Complete Setup & Launch Dashboard</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>

        <p class="text-[11px] text-[#929292] text-center mt-6">
          Public registration is disabled immediately after your account is created.
        </p>

      </div>

    </div>

    <script>
      const form = document.getElementById('setup-form') as HTMLFormElement;
      const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
      const errorMessage = document.getElementById('error-message') as HTMLSpanElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Creating administrator...</span>';

        const name = (document.getElementById('name') as HTMLInputElement).value;
        const username = (document.getElementById('username') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        try {
          const res = await fetch('/api/auth/setup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, username, email, password }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            submitBtn.innerHTML = '<span>Setup complete! Redirecting...</span>';
            window.location.href = '/admin';
          } else {
            errorAlert.classList.remove('hidden');
            errorMessage.textContent = data.error || 'Setup failed.';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Complete Setup & Launch Dashboard</span>';
          }
        } catch (err) {
          errorAlert.classList.remove('hidden');
          errorMessage.textContent = 'Server error. Please try again.';
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Complete Setup & Launch Dashboard</span>';
        }
      });
    </script>
  </body>
</html>
