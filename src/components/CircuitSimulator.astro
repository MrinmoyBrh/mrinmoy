---
---

<div id="architecture" class="py-24 border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-white/10 gap-6">
      <div class="max-w-3xl">
        <div class="flex items-center space-x-3 technical-mono text-xs text-cherry mb-4">
          <span class="w-2 h-2 rounded-full bg-cherry animate-pulse"></span>
          <span class="tracking-widest uppercase">SIMULATION HARNESS // LIVE ORCHESTRATION</span>
        </div>
        <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-pearl tracking-tight">
          Simulate the <span class="italic font-serif text-smoke-light font-normal">Gateway.</span>
        </h2>
      </div>
      <p class="text-smoke text-sm sm:text-base max-w-md leading-relaxed font-normal">
        Experience the exact logic powering the Adaptive AI Gateway: deterministic SHA-256 caching (&lt;5ms hits), BullMQ asynchronous task queueing, and automatic circuit breaker failovers.
      </p>
    </div>

    <!-- Simulator Shell -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Panel: Interactive Controller (5 cols) -->
      <div class="lg:col-span-5 bg-[#0A0A0A] border border-white/10 p-6 sm:p-8 shadow-2xl relative flex flex-col justify-between">
        
        <!-- Subtle cherry corner glow -->
        <div class="absolute top-0 right-0 w-24 h-24 bg-cherry/10 blur-2xl pointer-events-none"></div>

        <div>
          <!-- Controller Header -->
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
            <div class="flex items-center space-x-2.5">
              <span class="w-2.5 h-2.5 bg-cherry"></span>
              <span class="technical-mono text-xs text-pearl font-semibold uppercase tracking-wider">Gateway Client Console</span>
            </div>
            <span class="technical-mono text-[11px] text-smoke-dark">ENDPOINT: /v1/jobs/submit</span>
          </div>

          <!-- Inference Prompt Input -->
          <div class="mb-5">
            <label for="sim-prompt" class="block text-xs technical-mono text-smoke-light mb-2">
              AI INFERENCE PROMPT
            </label>
            <div class="relative">
              <input
                id="sim-prompt"
                type="text"
                value="Synthesize PostgreSQL connection pool configuration"
                class="w-full bg-[#080808] border border-white/10 px-3.5 py-2.5 text-xs sm:text-sm text-pearl technical-mono focus:border-cherry focus:outline-none focus:ring-1 focus:ring-cherry transition-colors"
              />
            </div>
            <p class="text-[11px] text-smoke mt-1.5 technical-mono">
              *Tip: Submit the identical prompt twice to verify the sub-5ms Redis cache hit.
            </p>
          </div>

          <!-- Upstream Outage Injection Toggle -->
          <div class="p-4 bg-[#080808] border border-white/10 mb-6">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-medium text-pearl block">Simulate Upstream Outage</span>
                <span class="text-[11px] text-smoke-light block">Inject HTTP 503 errors into Primary Provider (Groq)</span>
              </div>
              <label class="relative inline-flex items-center cursor-pointer shrink-0 ml-3">
                <input type="checkbox" id="sim-fail-toggle" class="sr-only peer">
                <div class="w-10 h-5 bg-[#1F1F1F] peer-focus:outline-none border border-white/10 peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-pearl after:border-smoke after:border after:h-4 after:w-4 after:transition-all peer-checked:bg-cherry"></div>
              </label>
            </div>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="flex items-center space-x-3 pt-4 border-t border-white/10">
          <button
            id="sim-submit-btn"
            type="button"
            class="flex-1 py-3 px-4 bg-cherry hover:bg-cherry/90 text-white font-bold technical-mono text-xs transition-all duration-200 flex items-center justify-center space-x-2 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cherry"
          >
            <span id="sim-btn-text">DISPATCH INGESTION REQUEST</span>
            <svg id="sim-spinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
          
          <button
            id="sim-reset-btn"
            type="button"
            title="Reset Redis Circuit & Cache State"
            class="py-3 px-4 bg-[#141414] hover:bg-[#1C1C1C] text-smoke-light hover:text-pearl border border-white/10 technical-mono text-xs transition-colors"
          >
            ↺ RESET
          </button>
        </div>

      </div>

      <!-- Right Panel: Live System Telemetry Stream (7 cols) -->
      <div class="lg:col-span-7 bg-[#0A0A0A] border border-white/10 p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
        
        <div>
          <!-- Live Telemetry Readout Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            
            <div class="p-3 bg-[#080808] border border-white/10">
              <span class="block text-[10px] technical-mono text-smoke">GROQ BREAKER</span>
              <span id="sim-groq-state" class="block text-xs font-bold technical-mono text-pearl mt-0.5">CLOSED (HEALTHY)</span>
              <span id="sim-groq-fails" class="block text-[10px] text-smoke-dark technical-mono">Failures: 0/3</span>
            </div>

            <div class="p-3 bg-[#080808] border border-white/10">
              <span class="block text-[10px] technical-mono text-smoke">FALLBACK BREAKER</span>
              <span id="sim-gemini-state" class="block text-xs font-bold technical-mono text-smoke-light mt-0.5">STANDBY</span>
              <span class="block text-[10px] text-smoke-dark technical-mono">Gemini 1.5-Flash</span>
            </div>

            <div class="p-3 bg-[#080808] border border-white/10">
              <span class="block text-[10px] technical-mono text-smoke">REDIS CACHE</span>
              <span id="sim-cache-status" class="block text-xs font-bold technical-mono text-smoke mt-0.5">0 KEYS (COLD)</span>
              <span class="block text-[10px] text-smoke-dark technical-mono">TTL: 3600s</span>
            </div>

            <div class="p-3 bg-[#080808] border border-white/10">
              <span class="block text-[10px] technical-mono text-smoke">EXECUTION LATENCY</span>
              <span id="sim-latency" class="block text-xs font-bold technical-mono text-pearl mt-0.5">-- ms</span>
              <span id="sim-source" class="block text-[10px] text-smoke-dark technical-mono">SOURCE: --</span>
            </div>

          </div>

          <!-- Terminal Output Stream -->
          <div class="bg-[#080808] border border-white/10 p-4 font-mono text-[11px] sm:text-xs leading-relaxed overflow-x-auto min-h-[220px] max-h-[260px] flex flex-col justify-end">
            <div id="sim-log-stream" class="space-y-1.5 text-smoke-light overflow-y-auto">
              <div class="text-smoke">[SYSTEM BOOT] Fastify HTTP Server listening on port 3000...</div>
              <div class="text-smoke">[REDIS] Connected to Redis cluster at 127.0.0.1:6379</div>
              <div class="text-smoke">[BULLMQ] Worker initialized with concurrency: 5</div>
              <div class="text-pearl font-semibold">[READY] Waiting for job submission request...</div>
            </div>
          </div>
        </div>

        <!-- Explanatory Dossier Footer -->
        <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-[11px] text-smoke technical-mono">
          <span>*Verified Against: src/workers/circuitBreaker.ts</span>
          <a href="https://github.com/MrinmoyBrh/ai-resilient-gateway" target="_blank" rel="noopener noreferrer" class="text-cherry hover:underline">
            View Source on GitHub →
          </a>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  // Client-side simulation of the verified AI Gateway architecture
  let groqFailures = 0;
  let groqState = 'CLOSED'; // 'CLOSED' | 'OPEN' | 'HALF_OPEN'
  let cacheStore: Record<string, { result: string; timestamp: number }> = {};
  
  const promptInput = document.getElementById('sim-prompt') as HTMLInputElement;
  const failToggle = document.getElementById('sim-fail-toggle') as HTMLInputElement;
  const submitBtn = document.getElementById('sim-submit-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('sim-reset-btn') as HTMLButtonElement;
  const btnText = document.getElementById('sim-btn-text');
  const spinner = document.getElementById('sim-spinner');
  
  const groqStateEl = document.getElementById('sim-groq-state');
  const groqFailsEl = document.getElementById('sim-groq-fails');
  const cacheStatusEl = document.getElementById('sim-cache-status');
  const latencyEl = document.getElementById('sim-latency');
  const sourceEl = document.getElementById('sim-source');
  const logStream = document.getElementById('sim-log-stream');

  function appendLog(text: string, colorClass = 'text-smoke-light') {
    if (!logStream) return;
    const time = new Date().toISOString().substring(11, 19);
    const line = document.createElement('div');
    line.className = colorClass;
    line.textContent = `[${time}] ${text}`;
    logStream.appendChild(line);
    logStream.scrollTop = logStream.scrollHeight;
  }

  function hashPrompt(prompt: string) {
    const norm = prompt.trim().toLowerCase();
    let hash = 0;
    for (let i = 0; i < norm.length; i++) {
      hash = ((hash << 5) - hash) + norm.charCodeAt(i);
      hash |= 0;
    }
    return 'sha256_' + Math.abs(hash).toString(16).padStart(8, '0');
  }

  function updateHUD() {
    if (groqStateEl) {
      if (groqState === 'CLOSED') {
        groqStateEl.textContent = 'CLOSED (HEALTHY)';
        groqStateEl.className = 'block text-xs font-bold technical-mono text-pearl mt-0.5';
      } else if (groqState === 'OPEN') {
        groqStateEl.textContent = 'TRIPPED (OPEN)';
        groqStateEl.className = 'block text-xs font-bold technical-mono text-cherry mt-0.5';
      } else {
        groqStateEl.textContent = 'HALF_OPEN (PROBING)';
        groqStateEl.className = 'block text-xs font-bold technical-mono text-smoke-light mt-0.5';
      }
    }

    if (groqFailsEl) {
      groqFailsEl.textContent = `Failures: ${groqFailures}/3`;
    }

    if (cacheStatusEl) {
      const keysCount = Object.keys(cacheStore).length;
      cacheStatusEl.textContent = `${keysCount} KEYS IN REDIS`;
      cacheStatusEl.className = keysCount > 0 
        ? 'block text-xs font-bold technical-mono text-cherry mt-0.5' 
        : 'block text-xs font-bold technical-mono text-smoke mt-0.5';
    }
  }

  submitBtn?.addEventListener('click', async () => {
    const prompt = promptInput?.value || '';
    if (!prompt.trim()) return;

    // UI loading state
    submitBtn.disabled = true;
    if (spinner) spinner.classList.remove('hidden');
    if (btnText) btnText.textContent = 'PROCESSING INGESTION...';

    const hash = hashPrompt(prompt);
    appendLog(`POST /v1/jobs/submit {"prompt": "${prompt.substring(0, 32)}..."}`, 'text-pearl font-semibold');
    appendLog(`Checking 24h rolling tenant token quota... [PASS]`, 'text-smoke');

    // 1. Check Redis Cache
    if (cacheStore[hash]) {
      // CACHE HIT (<5ms)
      await new Promise(r => setTimeout(r, 60)); // Small visual delay
      appendLog(`[REDIS CACHE HIT] Key: cache:prompt:${hash}`, 'text-cherry font-bold');
      appendLog(`Bypassing BullMQ queue & LLM inference entirely (<5ms execution).`, 'text-smoke-light');

      if (latencyEl) latencyEl.textContent = '3 ms';
      if (sourceEl) sourceEl.textContent = 'SOURCE: REDIS CACHE';

      finishRequest();
      return;
    }

    // CACHE MISS
    appendLog(`[CACHE MISS] Key: cache:prompt:${hash} -> Enqueueing BullMQ task...`, 'text-smoke');
    appendLog(`BullMQ worker assigned job [jobId: ${Math.random().toString(36).substring(2, 9)}]`, 'text-smoke');

    const shouldFailPrimary = failToggle?.checked;

    if (shouldFailPrimary) {
      // Simulate primary failure
      await new Promise(r => setTimeout(r, 450));
      groqFailures++;
      appendLog(`[ERROR] Upstream Groq returned 503 Service Unavailable (Attempt ${groqFailures}/3)`, 'text-cherry');

      if (groqFailures >= 3) {
        groqState = 'OPEN';
        appendLog(`[CIRCUIT BREAKER TRIPPED] Groq breaker is now OPEN. Cooldown: 20000ms.`, 'text-cherry font-bold');
      }

      // Fast-failover to Gemini
      appendLog(`[FAILOVER ACTIVATED] Executing secondary provider: Gemini 1.5-Flash...`, 'text-pearl font-semibold');
      await new Promise(r => setTimeout(r, 380));

      const synthesizedResult = `[Gemini Fallback Response] Optimized pool max=20, idleTimeoutMillis=30000`;
      cacheStore[hash] = { result: synthesizedResult, timestamp: Date.now() };

      appendLog(`[SUCCESS] Gemini fallback completed inference.`, 'text-pearl');
      appendLog(`[TELEMETRY] Usage logged to PostgreSQL: usage_logs (provider: gemini, latency: 830ms)`, 'text-smoke');
      appendLog(`[CACHE SET] Cached response to Redis (TTL: 3600s)`, 'text-smoke-light');

      if (latencyEl) latencyEl.textContent = '830 ms';
      if (sourceEl) sourceEl.textContent = 'PROVIDER: GEMINI (FALLBACK)';

    } else {
      // Primary succeeds
      await new Promise(r => setTimeout(r, 350));
      
      if (groqState === 'OPEN') {
        appendLog(`[CIRCUIT OPEN] Groq bypassed immediately without network overhead -> Fallback to Gemini`, 'text-pearl');
        await new Promise(r => setTimeout(r, 300));
        if (latencyEl) latencyEl.textContent = '340 ms';
        if (sourceEl) sourceEl.textContent = 'PROVIDER: GEMINI (FAST-FAILOVER)';
      } else {
        groqFailures = 0; // Reset upon successful primary call
        const synthesizedResult = `[Groq Llama 3.3-70B] PostgreSQL connection pool tuned for high concurrency.`;
        cacheStore[hash] = { result: synthesizedResult, timestamp: Date.now() };

        appendLog(`[ORCHESTRATOR] Groq primary responded with model: llama-3.3-70b-versatile`, 'text-pearl font-semibold');
        appendLog(`[CACHE SET] Result stored in Redis key: cache:prompt:${hash}`, 'text-smoke-light');
        appendLog(`[TELEMETRY] Recorded usage into PostgreSQL: tokens: { prompt: 15, completion: 45 }`, 'text-smoke');

        if (latencyEl) latencyEl.textContent = '350 ms';
        if (sourceEl) sourceEl.textContent = 'PROVIDER: GROQ (PRIMARY)';
      }
    }

    updateHUD();
    finishRequest();
  });

  function finishRequest() {
    submitBtn.disabled = false;
    if (spinner) spinner.classList.add('hidden');
    if (btnText) btnText.textContent = 'DISPATCH INGESTION REQUEST';
    updateHUD();
  }

  resetBtn?.addEventListener('click', () => {
    groqFailures = 0;
    groqState = 'CLOSED';
    cacheStore = {};
    if (failToggle) failToggle.checked = false;
    if (latencyEl) latencyEl.textContent = '-- ms';
    if (sourceEl) sourceEl.textContent = 'SOURCE: --';
    appendLog(`[RESET] Redis cache cleared. Groq Circuit Breaker restored to CLOSED.`, 'text-pearl');
    updateHUD();
  });
</script>
