---
import { skillCategories } from '../data/skills';
---

<section id="skills" class="py-24 border-b border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="flex items-center space-x-2 technical-mono text-xs text-orbital mb-3">
        <span class="w-2 h-2 rounded-full bg-orbital"></span>
        <span>VERIFIED TECHNICAL DOMAINS</span>
      </div>
      <h2 class="editorial-title text-4xl sm:text-5xl lg:text-6xl font-bold text-pearl mb-6">
        Architectural Competencies.
      </h2>
      <p class="text-smoke-light text-base sm:text-lg leading-relaxed">
        Curated across distributed queues, asynchronous runtimes, relational database modeling, and zero-trust container sandboxing. Every capability is anchored in production patterns rather than arbitrary proficiency percentages.
      </p>
    </div>

    <!-- Skills Category Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {skillCategories.map((category, idx) => (
        <div class="rounded-2xl bg-ink-900 border border-white/10 p-6 sm:p-7 flex flex-col justify-between shadow-surface-elevated hover:border-white/20 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
              <span class="technical-mono text-xs font-bold text-orbital">
                DOMAIN // 0{idx + 1}
              </span>
              <span class="text-[10px] technical-mono text-smoke-dark px-2 py-0.5 rounded bg-ink-950">
                {category.skills.length} TECHNOLOGIES
              </span>
            </div>

            <h3 class="font-display font-bold text-lg text-pearl mb-1.5">
              {category.title}
            </h3>
            
            <p class="text-xs text-smoke mb-6">
              {category.tagline}
            </p>

            <ul class="space-y-3.5" role="list">
              {category.skills.map((skill) => (
                <li class="p-3 rounded-xl bg-ink-950/70 border border-white/5 hover:border-orbital/30 transition-colors">
                  <div class="flex items-center justify-between mb-1">
                    <span class={`technical-mono text-xs font-semibold ${skill.primary ? 'text-coral' : 'text-pearl'}`}>
                      {skill.name}
                    </span>
                    {skill.primary && (
                      <span class="text-[9px] technical-mono font-bold text-coral bg-coral/10 px-1.5 py-0.5 rounded border border-coral/20">
                        CORE
                      </span>
                    )}
                  </div>
                  <p class="text-[11px] text-smoke-light leading-snug">
                    {skill.context}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
