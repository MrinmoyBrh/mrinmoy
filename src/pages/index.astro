---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import EditorialProjectShowcase from '../components/EditorialProjectShowcase.astro';
import CircuitSimulator from '../components/CircuitSimulator.astro';
import Principles from '../components/Principles.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import Timeline from '../components/Timeline.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import AtmosphericClouds from '../components/AtmosphericClouds.astro';
---

<Layout
  title="Mrinmoy Borah | Backend Software Engineer — Distributed Systems & Resilient Architectures"
  description="Personal portfolio of Mrinmoy Borah, Backend Software Engineer and B.Tech CSE student at Dhemaji Engineering College (2027). Specializing in BullMQ queues, Redis state machines, deterministic caching, and fault-tolerant gateways."
>
  <Header />

  <main id="main-content" class="relative">
    
    <!-- Hero Section (Preserved Untouched) -->
    <Hero />

    <!-- Continuous Atmospheric Cloud Container for All Sections Below Hero -->
    <div class="relative overflow-hidden">
      <!-- Atmospheric Dynamic Cloud Layer (Jet Black #080808, Smoke Grey #929292, Cherry Red #C72C41) -->
      <AtmosphericClouds />

      <!-- Systems / Projects Section (Cinematic Editorial Showcase) -->
      <EditorialProjectShowcase />

      <!-- Interactive Circuit Breaker & Queue Simulator -->
      <CircuitSimulator />

      <!-- Engineering Principles Manifesto -->
      <Principles />

      <!-- Curated Skills Matrix -->
      <SkillsGrid />

      <!-- Timeline / Education & Experience -->
      <Timeline />

      <!-- Contact & Interactive Terminal -->
      <ContactSection />
    </div>

  </main>

  <Footer />
</Layout>
