---
import { skillCategories } from '../data/skills';
---

<section id="skills" class="py-24 sm:py-32 border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 pb-8 border-b border-white/10 gap-6">
      <div class="max-w-3xl">
        <div class="flex items-center space-x-3 technical-mono text-xs text-cherry mb-4">
          <span class="w-2 h-2 rounded-full bg-cherry animate-pulse"></span>
          <span class="tracking-widest uppercase">TECHNICAL CAPABILITIES // SYSTEM MATRIX</span>
        </div>
        <h2 class="editorial-title text-5xl sm:text-6xl lg:text-7xl font-bold text-pearl tracking-tight">
          Architectural <span class="italic font-serif text-smoke-light font-normal">Competencies.</span>
        </h2>
      </div>
      <p class="text-smoke text-sm sm:text-base max-w-md leading-relaxed font-normal">
        A realistic summary of my technical competencies—spanning backend web development, programming languages, cloud fundamentals, developer tooling, and image processing.
      </p>
    </div>

    <!-- Asymmetrical Editorial Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Flagship Module: Backend & Web Development (Spans 7 cols) -->
      {(() => {
        const flagship = skillCategories[0];
        return (
          <div class="lg:col-span-7 bg-[#0A0A0A] border border-white/10 p-8 sm:p-10 relative shadow-2xl">
            <!-- Subtle cherry backlight -->
            <div class="absolute -top-10 -right-10 w-48 h-48 bg-cherry/10 blur-3xl pointer-events-none"></div>

            <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10 technical-mono text-xs">
              <span class="text-cherry font-bold">{flagship.code}</span>
              <span class="text-smoke-dark uppercase tracking-wider">CORE FOCUS</span>
            </div>

            <h3 class="editorial-title text-2xl sm:text-3xl font-bold text-pearl mb-2">
              {flagship.title}
            </h3>
            <p class="text-sm text-smoke-light mb-8 max-w-xl">
              {flagship.tagline}
            </p>

            <div class="space-y-4">
              {flagship.skills.map((skill) => (
                <div class="p-4 bg-[#080808] border border-white/5 hover:border-white/15 transition-colors flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                  <div class="flex items-center space-x-2.5">
                    {skill.highlight ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-cherry shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-white/20 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs sm:text-sm font-semibold text-pearl">
                      {skill.name}
                    </span>
                  </div>
                  <span class="text-[11px] sm:text-xs text-smoke-light technical-mono sm:text-right max-w-sm">
                    {skill.context}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })()}

      <!-- Second Module: Backend Runtimes & Frameworks (Spans 5 cols) -->
      {(() => {
        const mod2 = skillCategories[1];
        return (
          <div class="lg:col-span-5 bg-[#0A0A0A] border border-white/10 p-8 sm:p-10 relative shadow-2xl">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10 technical-mono text-xs">
              <span class="text-cherry font-bold">{mod2.code}</span>
              <span class="text-smoke-dark uppercase tracking-wider">LANGUAGES</span>
            </div>

            <h3 class="editorial-title text-2xl sm:text-3xl font-bold text-pearl mb-2">
              {mod2.title}
            </h3>
            <p class="text-sm text-smoke-light mb-8">
              {mod2.tagline}
            </p>

            <div class="space-y-3">
              {mod2.skills.map((skill) => (
                <div class="py-3 border-b border-white/5 flex items-start justify-between gap-3">
                  <div class="flex items-center space-x-2">
                    {skill.highlight ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-cherry shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-white/20 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs font-semibold text-pearl">
                      {skill.name}
                    </span>
                  </div>
                  <span class="text-[11px] text-smoke-light technical-mono text-right max-w-[220px]">
                    {skill.context}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })()}

      <!-- Three Equal Columns for Remaining Domains (Spans 4 cols each) -->
      {skillCategories.slice(2).map((cat) => (
        <div class="lg:col-span-4 bg-[#0A0A0A] border border-white/10 p-7 sm:p-8 relative shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 mb-5 border-b border-white/10 technical-mono text-xs">
              <span class="text-cherry font-bold">{cat.code}</span>
              <span class="text-smoke-dark text-[10px]">TOOLKIT</span>
            </div>

            <h3 class="editorial-title text-xl sm:text-2xl font-bold text-pearl mb-2">
              {cat.title}
            </h3>
            <p class="text-xs text-smoke-light mb-6">
              {cat.tagline}
            </p>

            <div class="space-y-3">
              {cat.skills.map((skill) => (
                <div class="py-2.5 border-t border-white/5">
                  <div class="flex items-center space-x-2 mb-1">
                    {skill.highlight ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-cherry shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-white/20 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs font-semibold text-pearl">
                      {skill.name}
                    </span>
                  </div>
                  <p class="text-[11px] text-smoke-light leading-snug pl-3.5">
                    {skill.context}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] technical-mono text-smoke-dark">
            <span>DOMAIN // OVERVIEW</span>
            <span class="text-smoke-dark">FOUNDATIONS</span>
          </div>
        </div>
      ))}

    </div>

  </div>
</section>
