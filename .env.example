# ==============================================================================
# Portfolio CMS Environment Variables Configuration Template
# Duplicate this file to .env or configure these variables in Vercel Dashboard.
# NEVER commit real credentials, database passwords, or secret tokens to Git!
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=production

# Disable telemetry
ASTRO_TELEMETRY_DISABLED=1

# Persistent Database Connection (PostgreSQL-compatible)
# Required for production serverless persistence on Vercel (e.g. Neon, Supabase, Vercel Postgres)
# In local development without this variable, the application falls back to local SQLite at data/portfolio.db.
# Example: postgres://default:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Vercel Blob Token (Durable Cloud Storage for Media Uploads)
# Configure in Vercel project settings to enable serverless media storage.
# If omitted locally, media is saved to public/uploads/.
BLOB_READ_WRITE_TOKEN=

# Session Cryptographic Key (Optional additional salt for session tokens)
SESSION_SECRET=change_me_to_a_cryptographically_secure_random_string_in_production
